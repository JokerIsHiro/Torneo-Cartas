{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "subterra-torneos.web.app",
        "destination": "https://www.subterratorneo.es",
        "type": 301
      },
      {
        "source": "subterra-torneos.firebaseapp.com",
        "destination": "https://www.subterratorneo.es",
        "type": 301
      }
    ]
  }
}
