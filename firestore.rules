rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /timers/{timerId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }
  }
}
