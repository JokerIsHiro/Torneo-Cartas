rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOrganizer() {
      return signedIn() && resource.data.organizerUid == request.auth.uid;
    }

    function createsOwnTournament() {
      return signedIn() && request.resource.data.organizerUid == request.auth.uid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();

      allow create: if createsOwnTournament();

      allow update: if isOrganizer()
        || (
          signedIn()
          && resource.data.status == 'setup'
          && request.resource.data.status == 'setup'
          && onlyChanges(['players'])
        )
        || (
          signedIn()
          && resource.data.status == 'active'
          && request.resource.data.status == 'active'
          && onlyChanges(['pendingResults'])
        );

      allow delete: if isOrganizer();
    }
  }
}
